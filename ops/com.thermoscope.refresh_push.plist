<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  THERMOSCOPE 2026 NRT update engine -- macOS launchd user LaunchAgent.

  Runs `python3 src/update_2026_nrt.py` directly (no shell wrapper, no
  `-m`) every StartInterval seconds, because the LightGBM/libomp
  DYLD_LIBRARY_PATH self-reexec shim (see
  src/train_source_classifier_lightgbm.py) needs sys.argv to be a clean
  script-path invocation to survive its os.execve re-exec correctly --
  already confirmed empirically to break under indirect invocations like
  `python3 -m unittest discover` in this same environment.

  This file is NOT auto-loaded by any code in this repository. To
  activate it (a persistent background job that will run indefinitely
  and periodically call live NASA FIRMS / OSM Overpass APIs), a human
  must explicitly run, from a terminal:

      mkdir -p ~/Library/LaunchAgents
      cp ops/com.thermoscope.nrt_update.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.thermoscope.nrt_update.plist

  To stop it:
      launchctl unload ~/Library/LaunchAgents/com.thermoscope.nrt_update.plist

  To change the update interval, edit StartInterval below (seconds)
  before loading -- currently 1800 (every 30 minutes). Re-fetching an
  unchanged window is cheap and a no-op (see
  fetch_and_merge_nrt_window's dedup), and a full cycle (fetch -> event
  construction -> evidence -> locked-model inference) completes in well
  under a minute against the current data volume, so 30-minute execution
  has a wide safety margin before the lock guard would ever see a
  genuinely overlapping run.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thermoscope.nrt_update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>ops/refresh_and_push.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/suvarchawadhwa/thermoscope-sih26162</string>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/suvarchawadhwa/thermoscope-sih26162/logs/nrt_update.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/suvarchawadhwa/thermoscope-sih26162/logs/nrt_update.err.log</string>
</dict>
</plist>
